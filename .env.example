# ==========================================================
# CAPRI AI Assistant - Environment Variables
# ==========================================================

# Google Gemini API Key (Recommended for fast multimodal vision & chat)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model name (gemini-flash-lite-latest is recommended for generous free-tier quotas)
GEMINI_MODEL=gemini-flash-lite-latest

# (Optional) OpenAI or Ollama local endpoint
# OPENAI_API_KEY=
# OPENAI_API_BASE=http://localhost:11434/v1

# Screen Watching Interval in seconds (default: random between 30 and 300)
MIN_WATCH_INTERVAL=30
MAX_WATCH_INTERVAL=300

# Voice hotkey (default is backslash '\')
VOICE_HOTKEY=\

# Speech-to-Text Language
STT_LANGUAGE=ru-RU

# Minecraft chat integration (optional)
# RCON must be enabled in the server's server.properties with the same password.
# Set enable-rcon=true, rcon.port=25575, and rcon.password=<password>.
MINECRAFT_RCON_HOST=127.0.0.1
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
# Optional if Minecraft is installed in a non-standard location:
# MINECRAFT_LOG_PATH=C:\\path\\to\\Minecraft\\logs\\latest.log
